generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRoleType {
  ADMIN
  OPERATOR
  CURATOR
  MODERATOR
  OBSERVER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum EventStatus {
  CONFIGURING
  WAITING
  LIVE
  PAUSED
  INTERVAL
  FINISHED
  EMERGENCY
}

enum ArenaMode {
  WAITING
  OPENING
  TOPIC_OVERVIEW
  SPEAKER_EXPOSITION
  PROVOCATION
  REBUTTAL
  POLL_OPEN
  POLL_RESULTS
  SELECTED_QUESTION
  INTERVAL
  COLLECTIVE_BUILDING
  CLOSING
  OPERATIONAL_NOTICE
}

enum StepType {
  OPENING
  TOPIC_BLOCK
  EXPOSITION
  PROVOCATION
  REBUTTAL
  POLL
  AUDIENCE_VOICE
  TRANSITION
  COLLECTIVE_CONTRIBUTION
  SYNTHESIS
  INTERVAL
  CLOSING
}

enum StepStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  SKIPPED
}

enum TimerStatus {
  IDLE
  RUNNING
  PAUSED
  EXPIRED
  FINISHED
}

enum QuestionStatus {
  RECEIVED
  ANALYZING
  APPROVED
  REJECTED
  DUPLICATE
  SELECTED
  DISPLAYED
  ANSWERED
}

enum PollStatus {
  DRAFT
  OPEN
  CLOSED
  RESULTS_PUBLISHED
}

model Event {
  id                     String      @id @default(cuid())
  slug                   String      @unique
  name                   String
  theme                  String
  institution            String
  estimatedAudience      Int         @default(150)
  programmedDurationMin  Int         @default(131)
  formatDescription      String
  status                 EventStatus @default(WAITING)
  scheduledStartAt       DateTime?
  actualStartAt          DateTime?
  actualEndAt            DateTime?
  questionCharLimit      Int         @default(400)
  maxQuestionsPerTopic   Int         @default(2)
  minQuestionIntervalSec Int         @default(15)
  requireAccessCode      Boolean     @default(false)
  accessCode             String?
  soundAlertsEnabled     Boolean     @default(true)
  showTimerOnArena       Boolean     @default(true)
  peakConnections        Int         @default(0)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  speakers            Speaker[]
  topics              Topic[]
  scheduleSteps       ScheduleStep[]
  liveState           LiveState?
  timerSessions       TimerSession[]
  participantSessions ParticipantSession[]
  questions           Question[]
  polls               Poll[]
  screenMessages      ScreenMessage[]
  auditLogs           AuditLog[]
}

model Speaker {
  id           String   @id @default(cuid())
  eventId      String
  slug         String
  name         String
  roleTitle    String?
  bio          String?
  photoUrl     String?
  displayOrder Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  mainTopics     Topic[]        @relation("TopicMainSpeaker")
  provokedTopics Topic[]        @relation("TopicProvoker")
  scheduleSteps  ScheduleStep[]

  @@unique([eventId, slug])
}

model Topic {
  id                    String     @id @default(cuid())
  eventId               String
  number                Int
  title                 String
  description           String?
  durationSec           Int        @default(1140)
  mainSpeakerId         String
  provokerId            String?
  provokerLabel         String
  status                StepStatus @default(PENDING)
  primaryQuestionId     String?
  reserveQuestionId     String?
  actualDurationSec     Int?
  expositionDurationSec Int?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  mainSpeaker   Speaker        @relation("TopicMainSpeaker", fields: [mainSpeakerId], references: [id])
  provoker      Speaker?       @relation("TopicProvoker", fields: [provokerId], references: [id])
  scheduleSteps ScheduleStep[]
  questions     Question[]
  poll          Poll?

  @@unique([eventId, number])
}

model ScheduleStep {
  id                  String     @id @default(cuid())
  eventId             String
  topicId             String?
  code                String
  title               String
  stepType            StepType
  arenaMode           ArenaMode
  sequenceOrder       Int
  macroOrder          Int?
  isMacroBlock        Boolean    @default(false)
  durationSec         Int
  speakerId           String?
  responsibleName     String?
  status              StepStatus @default(PENDING)
  alertTwoMinFired    Boolean    @default(false)
  alertThirtySecFired Boolean    @default(false)
  alertZeroFired      Boolean    @default(false)
  plannedStartAt      DateTime?
  plannedEndAt        DateTime?
  actualStartAt       DateTime?
  actualEndAt         DateTime?
  actualDurationSec   Int?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  topic         Topic?         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  speaker       Speaker?       @relation(fields: [speakerId], references: [id])
  timerSessions TimerSession[]

  @@unique([eventId, code])
  @@index([eventId, isMacroBlock, sequenceOrder])
}

model LiveState {
  id                      String      @id @default(cuid())
  eventId                 String      @unique
  seq                     Int         @default(1)
  lastEventType           String      @default("system.initialized")
  status                  EventStatus @default(WAITING)
  arenaMode               ArenaMode   @default(WAITING)
  activeMacroStepId       String?
  activeStepId            String?
  activeTopicId           String?
  activePollId            String?
  selectedQuestionId      String?
  screenMessageId         String?
  questionsOpen           Boolean     @default(false)
  timerStatus             TimerStatus @default(IDLE)
  timerStartedAt          DateTime?
  timerPausedAt           DateTime?
  timerDurationMs         Int         @default(0)
  timerAccumulatedPauseMs Int         @default(0)
  timerAdjustmentMs       Int         @default(0)
  showTimerOnArena        Boolean     @default(true)
  soundAlertsEnabled      Boolean     @default(true)
  emergencyActive         Boolean     @default(false)
  emergencyMessage        String?
  arenaLastHeartbeatAt    DateTime?
  updatedAt               DateTime    @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model TimerSession {
  id                   String      @id @default(cuid())
  eventId              String
  stepId               String
  plannedStartAt       DateTime?
  actualStartAt        DateTime    @default(now())
  plannedEndAt         DateTime?
  actualEndAt          DateTime?
  plannedDurationSec   Int
  effectiveDurationSec Int?
  pausedTotalSec       Int         @default(0)
  addedTotalSec        Int         @default(0)
  reducedTotalSec      Int         @default(0)
  overrunSec           Int         @default(0)
  pausesLog            Json?
  adjustmentsLog       Json?
  changedByUserId      String?
  changedByName        String?
  status               TimerStatus @default(RUNNING)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  event Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  step  ScheduleStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
}

model AdminRole {
  id                   String        @id @default(cuid())
  code                 AdminRoleType @unique
  name                 String
  description          String
  canOperateTimer      Boolean       @default(false)
  canModerateQuestions Boolean       @default(false)
  canManagePolls       Boolean       @default(false)
  canEditSchedule      Boolean       @default(false)
  canManageAccess      Boolean       @default(false)
  canExportReports     Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  users AdminUser[]
}

model AdminUser {
  id           String        @id @default(cuid())
  email        String        @unique
  fullName     String
  passwordHash String
  roleCode     AdminRoleType @default(OPERATOR)
  roleId       String?
  status       UserStatus    @default(ACTIVE)
  lastLoginAt  DateTime?
  revokedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  role            AdminRole?              @relation(fields: [roleId], references: [id])
  moderatedQ      Question[]              @relation("QuestionModerator")
  questionHistory QuestionStatusHistory[] @relation("QuestionHistoryActor")
  screenMessages  ScreenMessage[]
  auditLogs       AuditLog[]
}

model ParticipantSession {
  id                String    @id @default(cuid())
  sessionToken      String    @unique
  eventId           String
  anonymousCode     String
  userAgent         String?
  ipHash            String?
  consentAcceptedAt DateTime?
  lastSeenAt        DateTime  @default(now())
  isConnected       Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  questions Question[]
  votes     Vote[]

  @@index([eventId, lastSeenAt])
}

model Question {
  id              String         @id @default(cuid())
  eventId         String
  topicId         String
  sessionId       String
  clientRequestId String         @unique
  text            String
  status          QuestionStatus @default(RECEIVED)
  isPrimary       Boolean        @default(false)
  isReserve       Boolean        @default(false)
  displayedAt     DateTime?
  answeredAt      DateTime?
  moderatedById   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  event       Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  topic       Topic                   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  session     ParticipantSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  moderatedBy AdminUser?              @relation("QuestionModerator", fields: [moderatedById], references: [id])
  history     QuestionStatusHistory[]

  @@index([eventId, topicId, status])
  @@index([sessionId, topicId])
}

model QuestionStatusHistory {
  id              String          @id @default(cuid())
  questionId      String
  fromStatus      QuestionStatus?
  toStatus        QuestionStatus
  changedByUserId String?
  note            String?
  createdAt       DateTime        @default(now())

  question  Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  changedBy AdminUser? @relation("QuestionHistoryActor", fields: [changedByUserId], references: [id])
}

model Poll {
  id                 String     @id @default(cuid())
  eventId            String
  topicId            String     @unique
  number             Int
  question           String
  status             PollStatus @default(DRAFT)
  openedAt           DateTime?
  closedAt           DateTime?
  resultsPublishedAt DateTime?
  durationSec        Int        @default(60)
  totalVotes         Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  event   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  topic   Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   Vote[]

  @@unique([eventId, number])
}

model PollOption {
  id          String   @id @default(cuid())
  pollId      String
  optionOrder Int
  label       String
  votesCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  poll  Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes Vote[]

  @@unique([pollId, optionOrder])
}

model Vote {
  id              String   @id @default(cuid())
  pollId          String
  optionId        String
  sessionId       String
  clientRequestId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  poll    Poll               @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option  PollOption         @relation(fields: [optionId], references: [id], onDelete: Cascade)
  session ParticipantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([pollId, sessionId])
}

model ScreenMessage {
  id              String   @id @default(cuid())
  eventId         String
  title           String
  body            String
  severity        String   @default("INFO")
  isActive        Boolean  @default(false)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy AdminUser? @relation(fields: [createdByUserId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  eventId    String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  event Event?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  user  AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
